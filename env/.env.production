# ==============================================================================
# Gozaq - Production Environment Configuration (.env.production)
# ==============================================================================

# Application (Set to your actual domain)
APP_NAME=gozaq-api
APP_BASE_URL=https://api.yourdomain.com
APP_PORT=8080
APP_ENV=production
APP_READ_TIMEOUT=10
APP_WRITE_TIMEOUT=10
APP_IDLE_TIMEOUT=30

# CORS Allowed Origins (Set to your specific frontend domains)
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://admin.yourdomain.com

# Database (Production Managed PostgreSQL / Supabase / AWS RDS with SSL)
DATABASE_URL=postgres://dbuser:StrongSecurePassword123!@db-prod-cluster.your-cloud.com:5432/gozaq_prod_db?sslmode=require
DB_MAX_OPEN_CONNS=50
DB_MIN_IDLE_CONNS=10
DB_MAX_CONN_LIFETIME=30
DB_MAX_CONN_IDLE_TIME=5

# Cache Driver (Production Redis / Upstash / AWS ElastiCache with TLS)
CACHE_DRIVER=redis
REDIS_URL=rediss://default:StrongRedisAuthToken123!@redis-prod.your-cloud.com:6379/0

# JWT Authentication (Generate a high-entropy 256-bit secret, e.g. `openssl rand -hex 32`)
JWT_SECRET=CHANGE_THIS_TO_A_64_CHAR_HEX_ENTROPY_STRING_GENERATED_BY_OPENSSL
JWT_EXPIRE_MINUTES=60

# Mailer Driver (Production SMTP: SendGrid / Mailgun / AWS SES / Brevo)
MAILER_DRIVER=smtp
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=SG.your_production_sendgrid_api_key_here
SMTP_FROM=no-reply@yourdomain.com
SMTP_FROM_NAME="Gozaq Security"

# File Storage (Production AWS S3 / Cloudflare R2 / MinIO with CDN URL)
STORAGE_DRIVER=s3
STORAGE_LOCAL_DIR=./uploads
STORAGE_MAX_FILE_SIZE_MB=10
S3_BUCKET=your-production-s3-bucket-name
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY=YOUR_AWS_ACCESS_KEY_ID
S3_SECRET_KEY=YOUR_AWS_SECRET_ACCESS_KEY
S3_USE_SSL=true
S3_PUBLIC_URL=https://cdn.yourdomain.com

# Initial Database Seeder Credentials (Set strong root credentials for production initial setup)
INITIAL_ADMIN_EMAIL=root-admin@yourdomain.com
INITIAL_ADMIN_PASSWORD=SuperStrongInitialAdminPassword2026!#
