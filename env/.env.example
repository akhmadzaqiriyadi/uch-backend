# ==============================================================================
# Gozaq - Environment Configuration Master Template (.env.example)
# Copy this file to `.env` or use profiles in `env/` directory:
#   Development: cp env/.env.development .env
#   Production:  cp env/.env.production .env
# ==============================================================================

# Application
APP_NAME=gozaq-api
APP_BASE_URL=http://localhost:8080
APP_PORT=8080
APP_ENV=development
APP_READ_TIMEOUT=10
APP_WRITE_TIMEOUT=10
APP_IDLE_TIMEOUT=60

# CORS Allowed Origins (Comma-separated list, e.g. "http://localhost:3000,http://localhost:5173" or "*")
CORS_ALLOWED_ORIGINS=*

# Database (PostgreSQL pgx connection string)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/gozaq_db?sslmode=disable
DB_MAX_OPEN_CONNS=25
DB_MIN_IDLE_CONNS=5
DB_MAX_CONN_LIFETIME=60
DB_MAX_CONN_IDLE_TIME=15

# Cache Driver (Driver: "redis" or "memory" / "noop" for mock/offline dev)
CACHE_DRIVER=redis
REDIS_URL=redis://localhost:6379/0

# JWT Authentication (HMAC SHA-256 Secret)
JWT_SECRET=super-secret-jwt-key-change-in-production-12345678
JWT_EXPIRE_MINUTES=1440

# Mailer Driver (Driver: "smtp" or "log" for mock stdout console preview)
MAILER_DRIVER=log
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@gozaq.com
SMTP_FROM_NAME="Gozaq Team"

# File Storage (Driver: "local" or "s3" / "r2" / "minio")
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./uploads
STORAGE_MAX_FILE_SIZE_MB=5
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_USE_SSL=true
S3_PUBLIC_URL=

# Initial Database Seeder Credentials
INITIAL_ADMIN_EMAIL=admin@gozaq.com
INITIAL_ADMIN_PASSWORD=Admin123!
